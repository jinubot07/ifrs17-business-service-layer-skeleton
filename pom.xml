<?xml version="1.0" encoding="UTF-8"?>
<!--
  IFRS17 Business Service Layer - Skeleton (통신 껍데기)
  설계서: IFRS17-BSL-SDD-001 v1.3

  [제약]
  - Java 8 호환 (설계서 2장 현행 환경)
  - DB / MyBatis / SqlMap 의존성 완전 배제 (Skeleton 단계)
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <groupId>com.koreanre.ifrs17</groupId>
  <artifactId>ifrs17-business-service-layer-skeleton</artifactId>
  <version>1.2.0-SKELETON</version>
  <name>IFRS17 Business Service Layer Skeleton</name>
  <description>IFRS17 Business Service Layer - REST/JSON 통신 껍데기 (Mock Data)</description>

  <properties>
    <java.version>1.8</java.version>
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- java.time (OffsetDateTime) 직렬화용 - spring-boot-starter-web 에 포함 -->
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>ifrs17-business-service-layer-skeleton</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- 콘솔 감사로그(한글)가 깨지지 않도록 테스트 JVM 인코딩을 고정한다. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
