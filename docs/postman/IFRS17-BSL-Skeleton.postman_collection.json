{
  "info": {
    "name": "IFRS17 Business Service Layer - Skeleton v1.0",
    "description": "IFRS17-BSL-SDD-001 v1.3 기준 REST/JSON 통신 껍데기 검증용 Collection. DB/Legacy 미연동(Mock Data).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "TEST-CLIENT",
      "type": "string"
    },
    {
      "key": "closingYearMonth",
      "value": "2026-06",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00. [DoD] 결산 진행상태 조회 (IFRS17.CLOSING.STATUS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
              "var body = pm.response.json();",
              "pm.test('status=SUCCESS', function () { pm.expect(body.status).to.eql('SUCCESS'); });",
              "pm.test('표준 Envelope 필드 존재', function () {",
              "  pm.expect(body).to.have.property('requestId');",
              "  pm.expect(body).to.have.property('traceId');",
              "  pm.expect(body).to.have.property('serviceId');",
              "  pm.expect(body).to.have.property('serviceVersion');",
              "  pm.expect(body).to.have.property('sourceSystem');",
              "  pm.expect(body).to.have.property('processedAt');",
              "  pm.expect(body).to.have.property('elapsedMs');",
              "  pm.expect(body).to.have.property('result');",
              "  pm.expect(body).to.have.property('warnings');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Client-ID", "value": "{{clientId}}" },
          { "key": "Authorization", "value": "Bearer dummy-token", "description": "Skeleton 단계에서는 검증하지 않음" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceVersion\": \"1.0\",\n  \"parameters\": {\n    \"closingYearMonth\": \"{{closingYearMonth}}\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/business-services/v1/IFRS17.CLOSING.STATUS:execute",
          "host": ["{{baseUrl}}"],
          "path": ["api", "business-services", "v1", "IFRS17.CLOSING.STATUS:execute"]
        },
        "description": "개발 지시서 5장 최종 검증(Definition of Done) 요청."
      }
    },
    {
      "name": "01. 전표 생성·반영 상태 조회 (IFRS17.JOURNAL.STATUS)",
