          "raw": "{\n  \"serviceVersion\": \"1.0\",\n  \"parameters\": {\n    \"closingYearMonth\": \"{{closingYearMonth}}\",\n    \"journalType\": \"CSM_AMORTIZATION\"\n  },\n  \"options\": {\n    \"locale\": \"ko-KR\",\n    \"includeDetails\": false\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/business-services/v1/IFRS17.JOURNAL.STATUS:execute",
          "host": ["{{baseUrl}}"],
