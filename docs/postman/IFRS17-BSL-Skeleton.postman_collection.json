          "mode": "raw",
          "raw": "{\n  \"serviceVersion\": \"1.0\",\n  \"parameters\": {\n    \"closingYearMonth\": \"{{closingYearMonth}}\",\n    \"__simulate\": \"FORBIDDEN\"\n  }\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/business-services/v1/IFRS17.CLOSING.STATUS:execute",
          "host": ["{{baseUrl}}"],
